{
  "expo": {
    "name": "LabourApp",
    "slug": "LabourApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#128C7E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow LabourApp to access your photos to set profile picture",
        "NSCameraUsageDescription": "Allow LabourApp to access camera to take profile picture"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.shaunjay.LabourApp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "2126dee5-1219-4d7b-87d5-0a202917a81c"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LabourApp to access your photos to set profile picture",
          "cameraPermission": "Allow LabourApp to access camera to take profile picture"
        }
      ]
    ]
  }
}
